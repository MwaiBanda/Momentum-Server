# Copy this file to .env and replace the required values.
# Never commit real credentials.

ENVIRONMENT=development
HOST=127.0.0.1
PORT=8080

# Required
DATABASE_URL=postgres://postgres:postgres@localhost:5432/momentum?sslmode=disable
REDIS_URL=redis://localhost:6379
API_KEY=replace-with-a-local-development-key

# Firebase
FIREBASE_PROJECT_ID=

# External integrations
SERMONCLOUD_URL=https://api.sermoncloud.com/momentum-church-1/sermons
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_VERSION=
PLANNING_CENTER_URL=
PLANNING_CENTER_TOKEN_URL=
EMAIL_APP_PASSWORD=

# OpenTelemetry
OTEL_SERVICE_NAME=momentum-api
# Set this when running the local observability stack.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Fiber Uptime
# Uptime is always enabled. Keep bearer authentication enabled unless the app
# is bound only to loopback or protected by a trusted reverse proxy.
FIBER_UPTIME_REQUIRE_BEARER_AUTH=true
FIBER_UPTIME_SERVICE_ID=momentum-api
FIBER_UPTIME_SERVICE_NAME=Momentum API
FIBER_UPTIME_KEY_PREFIX=momentum:uptime
FIBER_UPTIME_RETENTION_DAYS=30
FIBER_UPTIME_SAMPLE_INTERVAL_SECONDS=60
